{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "axiom-api": {
      "root": "crates/axiom-api",
      "runtime": "rust"
    },
    "axiom-cli": {
      "root": "crates/axiom-cli",
      "runtime": "rust"
    },
    "axiom-worker": {
      "root": "crates/axiom-worker",
      "runtime": "rust"
    },
    "dashboard": {
      "root": "packages/dashboard",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "dashboard"
      }
    }
  ]
}