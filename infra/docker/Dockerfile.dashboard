FROM node:20-bookworm-slim AS dashboard-builder

WORKDIR /app
COPY packages/dashboard/package.json packages/dashboard/pnpm-lock.yaml ./packages/dashboard/
COPY packages/sdk/package.json packages/sdk/pnpm-lock.yaml ./packages/sdk/
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

RUN npm install -g pnpm && pnpm install --frozen-lockfile

COPY . .

WORKDIR /app/packages/dashboard
RUN pnpm run build

FROM nginx:alpine
COPY --from=dashboard-builder /app/packages/dashboard/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
