FROM rust:1.75-slim-bookworm AS rust-builder
WORKDIR /app
COPY . .
RUN cargo build --release --bin axiom-worker

FROM node:20-bookworm-slim AS node-builder
WORKDIR /app
COPY packages/sdk/package.json packages/sdk/pnpm-lock.yaml ./packages/sdk/
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install --frozen-lockfile
COPY . .
WORKDIR /app/packages/sdk
RUN pnpm run build

FROM node:20-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=rust-builder /app/target/release/axiom-worker /usr/local/bin/axiom-worker
COPY --from=node-builder /app/packages/sdk/dist /app/sidecar/dist
COPY --from=node-builder /app/packages/sdk/package.json /app/sidecar/
# Also need to copy node_modules or run npm install for production? 
# The SDK sidecar dependencies are minimal (just tsx? Actually it's built to JS, so just node is needed).
# Let's assume dist/app.js is self-contained or we copy node_modules.
COPY --from=node-builder /app/node_modules /app/node_modules
COPY --from=node-builder /app/packages/sdk/node_modules /app/sidecar/node_modules

# Non-root user
RUN useradd -m axiom && chown -R axiom:axiom /app
USER axiom

ENV SIDECAR_PATH=/app/sidecar/dist/app.js
EXPOSE 9000

CMD ["axiom-worker"]
